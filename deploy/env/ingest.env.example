# Copy to /etc/ingest/ingest.env on the server.
# Keep private endpoints and credentials ONLY on server.

# Polling behavior
D65_DEFAULT_LOOKBACK_SECONDS=600
D65_OVERLAP_SECONDS=120
B3SR_DEFAULT_LOOKBACK_SECONDS=600
B3SR_OVERLAP_SECONDS=120

# Streaming strategy
D65_S3_STREAMING_STRATEGY=auto
B3SR_S3_STREAMING_STRATEGY=auto

# Server endpoints (set to local/container DNS on victoriametrics host)
D65_SERVER=http://localhost:8428
B3SR_SERVER=http://localhost:8431

# B3SR source bucket
B3SR_S3_BUCKET=b3sr-telematics

# Clayton: independent image, SQLite checkpoints and all-history ingestion.
# Bucket fvt-telematics and device/DBC defaults are bundled with decoder.Clayton.
CLAYTON_SERVER=http://127.0.0.1:8433
CLAYTON_MAX_FILES_PER_DEVICE=10
# Deployment-only (export when invoking scripts/deploy_clayton.sh):
# CLAYTON_BIND_IP=100.87.35.92
# Optional wrapper overrides:
# CLAYTON_RUNNER_IMAGE=ingest-runner:clayton
# CLAYTON_ROOT_DIR=/home/ubuntu/ingest/clayton-current
# CLAYTON_STATE_DIR=/home/ubuntu/ingest/cursor

# Optional TLS overrides for S3 or custom endpoints.
# For local WSL runs, put Zscaler_Root_CA.crt in repository root; it is auto-detected.
# AWS_S3_TLS_INSECURE=true
# AWS_S3_CA_BUNDLE=/path/to/custom-ca.pem
# AWS_CA_BUNDLE=/path/to/custom-ca.pem
# REQUESTS_CA_BUNDLE=/path/to/custom-ca.pem
# SSL_CERT_FILE=/path/to/custom-ca.pem
# CURL_CA_BUNDLE=/path/to/custom-ca.pem
